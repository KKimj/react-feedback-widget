{
  "name": "@team-spacey/react-feedback-widget",
  "version": "2.3.5",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "A visual feedback widget for React applications with element selection, screenshot capture, professional dashboard, and Jira/Google Sheets integrations",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/types.d.ts",
      "import": "./dist/lib/index.esm.js",
      "require": "./dist/lib/index.js"
    },
    "./ui": {
      "types": "./dist/types.d.ts",
      "import": "./dist/ui/index.esm.js",
      "require": "./dist/ui/index.js"
    },
    "./dashboard": {
      "types": "./dist/types.d.ts",
      "import": "./dist/dashboard/index.esm.js",
      "require": "./dist/dashboard/index.js"
    },
    "./capture": {
      "types": "./dist/types.d.ts",
      "import": "./dist/capture/index.esm.js",
      "require": "./dist/capture/index.js"
    },
    "./capture/core": {
      "types": "./dist/types.d.ts",
      "import": "./dist/capture/core.esm.js",
      "require": "./dist/capture/core.js"
    },
    "./capture/worker": {
      "import": "./dist/capture/worker.js",
      "require": "./dist/capture/worker.js"
    },
    "./server": {
      "types": "./dist/types.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./server/jira": {
      "import": "./dist/server/jira.js",
      "require": "./dist/server/jira.js"
    },
    "./server/sheets": {
      "import": "./dist/server/sheets.js",
      "require": "./dist/server/sheets.js"
    },
    "./server/github": {
      "import": "./dist/server/github.js",
      "require": "./dist/server/github.js"
    },
    "./server/github-action": {
      "import": "./dist/server/github-action.js",
      "require": "./dist/server/github-action.js"
    },
    "./server/linear": {
      "import": "./dist/server/linear.js",
      "require": "./dist/server/linear.js"
    },
    "./server/notion": {
      "import": "./dist/server/notion.js",
      "require": "./dist/server/notion.js"
    },
    "./server/supabase": {
      "import": "./dist/server/supabase.js",
      "require": "./dist/server/supabase.js"
    },
    "./server/webhook": {
      "import": "./dist/server/webhook.js",
      "require": "./dist/server/webhook.js"
    },
    "./server/upload-url": {
      "import": "./dist/server/upload-url.js",
      "require": "./dist/server/upload-url.js"
    },
    "./integrations": {
      "import": "./dist/integrations/index.js",
      "require": "./dist/integrations/index.js"
    },
    "./destinations": {
      "types": "./dist/types.d.ts",
      "import": "./dist/destinations/index.esm.js",
      "require": "./dist/destinations/index.js"
    },
    "./config": {
      "types": "./dist/types.d.ts",
      "import": "./dist/config.esm.js",
      "require": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "rvf": "./bin/rvf.mjs",
    "react-visual-feedback": "./bin/rvf.mjs"
  },
  "scripts": {
    "build": "rollup -c",
    "build:check-size": "node scripts/check-bundle-size.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "react",
    "feedback",
    "widget",
    "screenshot",
    "bug-report",
    "user-feedback",
    "dashboard",
    "feedback-management",
    "status-tracking",
    "issue-tracker",
    "jira",
    "jira-integration",
    "google-sheets",
    "zapier",
    "screen-recording"
  ],
  "author": "Murali <murali.g@hyperverge.co>",
  "license": "MIT",
  "homepage": "https://react-library-demo-rosy.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-SpaceY/react-feedback-widget.git"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "styled-components": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.263.1",
    "modern-screenshot": "^4.6.7",
    "react-sketch-canvas": "^8.0.0",
    "source-map-js": "^1.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/web-worker": "^1.6.1",
    "axe-core": "^4.12.1",
    "gzip-size": "^7.0.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.9.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "styled-components": "^6.1.19",
    "vitest": "^1.6.1"
  }
}
