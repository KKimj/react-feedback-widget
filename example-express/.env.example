# ── 통합 e2e 서버(mini-e2e-server.mjs) 설정 ──
# 복사해서 .env 로 쓰거나 export 로 주입하세요.

# ── 서비스 계정 (선택) ──
# SA 키 파일 경로. 있으면 Storage 업로드 + Sheets 기입 활성화.
# 없으면(주석 처리) Storage/Sheets 는 건너뛰고 Slack 만 동작합니다.
#   → 시트가 public / Apps Script write endpoint 인 경우 SA 없이도 운영 가능
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Storage (SA 있을 때만 사용) ──
STORAGE_BUCKET=your-project.firebasestorage.app
STORAGE_PATH=public/qa

# ── Google Sheets (SA 있을 때만 기입) ──
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
SHEET_NAME=Feedback
# Slack 카드의 "스프레드시트에서 보기" 링크 (선택).
# 미설정 시 SA 로 기입 탭(SHEET_NAME)의 gid 를 조회해 정확한 탭 링크를 자동 생성한다.
# 명시하려면 실제 기입 탭의 gid 까지 포함할 것 (gid 없으면 첫 탭으로 열림).
# SHEET_URL=https://docs.google.com/spreadsheets/d/<ID>/edit?gid=<탭gid>#gid=<탭gid>

# ── Slack (항상 동작) ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# 또는 Bot token 모드 (thread 답글 등 고급 기능용)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#feedback

# 서버 포트
PORT=3010

# ── feedback.config.js (destination / UI) ──
FEEDBACK_UI_VARIANT=two-column
SLACK_CHANNEL=#feedback
ENABLE_SHEETS=true
ENABLE_SLACK=true
