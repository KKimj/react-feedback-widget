# ── 통합 e2e 서버(mini-e2e-server.mjs) 설정 ──
# 복사해서 .env 로 쓰거나 export 로 주입하세요. 아래 값이 실제로 서버가 읽는 전부입니다.
#
# 참고: 위젯 UI variant 와 destination on/off 는 .env 가 아니라 코드에서 결정합니다.
#   - UI variant → example/src/App.jsx 의 <FeedbackProvider> prop
#   - destination on/off → mini-e2e 가 SA(Storage/Sheets)·webhook(Slack) 유무로 자동 판단
#   (feedback.config.js 는 rvf/defineConfig 방식 전용이라 이 원클릭 경로에서는 쓰이지 않습니다.)

# ── 서비스 계정 (선택) ──
# SA 키 파일 경로. 있으면 Storage 업로드 + Sheets 기입 활성화.
# 없으면(주석 처리) Storage/Sheets 는 건너뛰고 Slack 만 동작합니다.
#   → 시트가 public / Apps Script write endpoint 인 경우 SA 없이도 운영 가능
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Storage (SA 있을 때만 사용) ──
STORAGE_BUCKET=your-project.firebasestorage.app
STORAGE_PATH=public/qa

# ── Google Sheets (SA 있을 때만 기입) ──
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
SHEET_NAME=Feedback
# Slack 카드의 "스프레드시트에서 보기" 링크 (선택).
# 미설정 시 SA 로 기입 탭(SHEET_NAME)의 gid 를 조회해 정확한 탭 링크를 자동 생성한다.
# 명시하려면 실제 기입 탭의 gid 까지 포함할 것 (gid 없으면 첫 탭으로 열림).
# SHEET_URL=https://docs.google.com/spreadsheets/d/<ID>/edit?gid=<탭gid>#gid=<탭gid>
#
# 시트 포맷 초기화: node init-sheet.mjs (헤더/서식/드롭다운). 기존 데이터까지 비우려면:
#   CLEAR_DATA=1 node init-sheet.mjs

# ── Slack ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# webhook 대신 Bot token 모드 (thread 답글 등 고급 기능). 이 모드에서만 SLACK_CHANNEL 사용.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#feedback

# ── 서버 포트 (선택, 기본 3010) ──
PORT=3010
